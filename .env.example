# Taskinator Environment Configuration
# Copy this file to .env and fill in your own secure values.

# --- Dynamic URL Construction ---
PROTOCOL=http
HOST=0.0.0.0
PORT=9900

# REQUIRED: A strong random secret key (min 32 chars)
SECRET_KEY=replace-me-with-a-random-32-char-secret-key!!!

# REQUIRED: Password for the initial admin user (username: admin)
ADMIN_PASSWORD=ChangeMeToAStrongPassword123!

# Set to 'true' in production (requires HTTPS)
COOKIE_SECURE=false
